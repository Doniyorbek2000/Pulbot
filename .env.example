# ---------------------------------------------------------------------------
# PulBot — asosiy sozlamalar / Основные настройки / Core settings
# ---------------------------------------------------------------------------

# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Bot username (deep-link yasash uchun, @ belgisisiz)
BOT_USERNAME=YourPulBot

# Super-adminlar (Telegram ID), vergul bilan
ADMIN_IDS=123456789

# Ma'lumotlar bazasi.
#   SQLite:     sqlite+aiosqlite:///pulbot.db
#   PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/pulbot
DATABASE_URL=sqlite+aiosqlite:///pulbot.db

# FSM storage. Bo'sh bo'lsa xotirada saqlanadi (bitta instans uchun).
REDIS_URL=

# Standart til: uz | ru | en
DEFAULT_LANGUAGE=uz

# ---------------------------------------------------------------------------
# Moliyaviy sozlamalar (keyinchalik admin panelidan ham o'zgartiriladi)
# ---------------------------------------------------------------------------

# Platforma komissiyasi, bazis punktda (500 = 5%)
COMMISSION_BPS=500

# Minimal to'ldirish / minimal narx (yulduzchada)
MIN_TOPUP_STARS=1
MIN_PRICE_STARS=1
MAX_PRICE_STARS=100000

# Pul yechish
MIN_WITHDRAW_STARS=1000
WITHDRAW_FEE_BPS=200
# To'ldirilgandan keyin necha soat pul yechib bo'lmaydi (anti-fraud hold)
WITHDRAW_HOLD_HOURS=72

# Pullik xabar uchun escrow: qabul qiluvchi javob bermasa necha soatdan keyin
# pul avtomatik unga o'tadi (0 = escrow o'chirilgan, pul darrov o'tadi)
DEFAULT_HOLD_HOURS=48

# Kurslar (1 yulduzcha necha so'm / necha dollar). Admin panelidan yangilanadi.
RATE_UZS_PER_STAR=170
RATE_USD_PER_STAR=0.013

# Loglar
LOG_LEVEL=INFO

# Webhook rejimi (bo'sh bo'lsa long-polling ishlaydi)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
